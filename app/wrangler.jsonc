{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "agent-street",
	"compatibility_date": "2026-08-17",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./workers/app.ts",
	// workers.dev is OFF: this worker reaches its sibling workers via same-account
	// service bindings (see `services` below), and those loop (Cloudflare error
	// 1042) when the worker is invoked through its own *.workers.dev URL. On a real
	// zone (the custom domain below) the bindings resolve fine, so agentstreet.trade
	// is the single canonical URL.
	"workers_dev": false,
	// Custom domain (Cloudflare-registered zone in this account). `custom_domain`
	// auto-provisions the DNS record + edge cert on deploy. Apex + www both serve
	// this worker. The *.workers.dev URL keeps working alongside these.
	"routes": [
		{ "pattern": "agentstreet.trade", "custom_domain": true },
		{ "pattern": "www.agentstreet.trade", "custom_domain": true }
	],
	// Nota: estos `vars` son los defaults de DEPLOY (prod). Para dev 100% local
	// contra workers en localhost, sobrescribe con `.dev.vars` (gitignored).
	"vars": {
		// Worker proxy a 8004scan (workers/8004-proxy) — desplegado.
		"PROXY_8004_URL": "https://agent-street-8004-proxy.zevlat.workers.dev",
		// Worker indexer onchain (workers/onchain-indexer): portfolio + trades del agent_wallet.
		"ONCHAIN_INDEXER_URL": "https://agent-street-onchain-indexer.zevlat.workers.dev",
		// Worker de analítica de demanda (workers/analytics): eventos view/hire + trending.
		"ANALYTICS_URL": "https://agent-street-analytics.zevlat.workers.dev",
		// Seam de contratación x402 (workers/hire-x402) — verificador onchain.
		// Modelo client-pays: el usuario firma/paga la transferencia desde su wallet;
		// el worker publica el quote (402) y VERIFICA la tx onchain (POST /v1/hire).
		// Dev local: sobrescribe a http://localhost:8791 vía .dev.vars.
		"HIRE_X402_URL": "https://agent-street-hire-x402.zevlat.workers.dev",
		// Worker de portfolios (workers/portfolios): sets de agentes user-made +
		// contadores de gamificación + afinidad "frequently hired together".
		// Additive: la app funciona sin él (curated se resuelven app-side).
		// Dev local: sobrescribe a http://localhost:8792 vía .dev.vars.
		"PORTFOLIOS_URL": "https://agent-street-portfolios.zevlat.workers.dev",
		// Agent-native surface (workers/mcp): the MCP endpoint an orchestrator agent
		// connects to in order to discover, evaluate, hire and manage listed agents.
		// Surfaced read-only in the UI (For Agents page + per-listing access panel).
		"MCP_URL": "https://agent-street-mcp.zevlat.workers.dev",
		// Registrar (services/registrar, FastAPI) — acuña identidad ERC-8004 testnet
		// para el wizard "Create agent". ÚNICA pieza no-Cloudflare: apunta a la
		// instancia en Render (Docker web service). Dev local: sobrescribe con
		// http://localhost:8080 vía .dev.vars. Hoy en DRY_RUN (sin TREASURY_PRIVATE_KEY).
		"REGISTRAR_URL": "https://agent-street.onrender.com"
	},
	// Service bindings — same-account worker-to-worker composition. A plain fetch to
	// these workers over *.workers.dev loops back to THIS app worker (which has no such
	// route) and 404s, so server-side loaders route through these bindings instead. The
	// *_URL vars above stay as the local-dev fallback (real external fetch, no binding).
	// The app must keep working without them (seed fallback), so they are additive.
	"services": [
		{ "binding": "PROXY_8004", "service": "agent-street-8004-proxy" },
		{ "binding": "ONCHAIN_INDEXER", "service": "agent-street-onchain-indexer" },
		{ "binding": "ANALYTICS", "service": "agent-street-analytics" },
		{ "binding": "HIRE_X402", "service": "agent-street-hire-x402" },
		{ "binding": "PORTFOLIOS", "service": "agent-street-portfolios" }
	]
}
